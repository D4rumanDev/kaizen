<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Tráfico en claro prohibido salvo donde hace falta. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Proxy local del reproductor (KaizenProxy) -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Streamtape: su página y la redirección al vídeo usan http; sin esto la URL de vídeo llega vacía. -->
        <domain includeSubdomains="true">streamtape.com</domain>
        <domain includeSubdomains="true">tapecontent.net</domain>
        <!-- Mediafire (FireServer): el enlace de descarga directa es http. -->
        <domain includeSubdomains="true">mediafire.com</domain>
    </domain-config>
</network-security-config>
